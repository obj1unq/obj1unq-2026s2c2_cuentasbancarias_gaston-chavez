import casa.*

describe "casa de pepe y julian" {

  // Descomentar si hiciera falta un metodo para inicializar el ambiente
  // method initialize() {
  // }

    test "Casa cuenta corriente" {
  casa.cuentaPorDefecto(cuentaCorriente)
  cuentaCorriente.depositar(300)
  assert.equals(0, casa.totalGastado())
  assert.equals(300, cuentaCorriente.saldo())

  casa.gastar(200)
  assert.equals(100, cuentaCorriente.saldo())
  assert.equals(200, casa.totalGastado())

  casa.gastar(400)
  assert.equals(-300, cuentaCorriente.saldo())
  assert.equals(600, casa.totalGastado())

  casa.cambioDeMes()
  assert.equals(0, casa.totalGastado())
}

test "Casa cuenta gastos mantemiento" {
  cuentaGastos.costoOperacion(20)
  cuentaGastos.depositar(1000)
  assert.equals(980, cuentaGastos.saldo())

  cuentaGastos.extraer(580)
  assert.equals(400, cuentaGastos.saldo())

  cuentaGastos.extraer(500)
  assert.equals(-100, cuentaGastos.saldo())

  cuentaGastos.depositar(150)
  assert.equals(30, cuentaGastos.saldo())
}

test "Casa cuenta gastos mantemiento caso excepcional" {
  cuentaGastos.costoOperacion(20)
  assert.throwsException({cuentaGastos.depositar(20)})
}

test "Viveres y Reparaciones" {
  casa.cuentaPorDefecto(cuentaCorriente)
  cuentaCorriente.depositar(2000)
  casa.reparaciones(1000)
  assert.equals(false, casa.tieneViveresSuficientes())
  assert.equals(true, casa.hayQueHacerReparacion())
  assert.equals(false, casa.estaEnOrden())

  assert.throwsException({casa.comprarViveres(80,2)}) //Intenta comprar 80% viveres de calidad 2
  assert.equals(2000, cuentaCorriente.saldo())
  assert.equals(0, casa.totalGastado())

  casa.comprarViveres(20, 2)
  assert.equals(true, casa.tieneViveresSuficientes())
  assert.equals(50, casa.viveres())
  assert.notThat(casa.estaEnOrden())
  assert.equals(1960, cuentaCorriente.saldo())
  assert.equals(40, casa.totalGastado())

  casa.hacerReparaciones()
  assert.notThat(casa.hayQueHacerReparacion())
  assert.that(casa.estaEnOrden())
  assert.equals(960, cuentaCorriente.saldo())
  assert.equals(1040, casa.totalGastado())
}
}

